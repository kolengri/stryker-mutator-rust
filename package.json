{
  "name": "stryker-mutator-rust",
  "version": "0.1.0",
  "description": "Rust-backed StrykerJS compatibility runner with content-addressed instrumentation caching",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "bin": {
    "stryker-rust": "bin/stryker-rust.js"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/runtime.d.ts",
      "import": "./lib/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "native/*.node",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "napi build --release --platform --output-dir native --js binding.cjs --dts binding.d.cts",
    "test": "node --test test/*.test.js",
    "test:integration": "node scripts/integration.js",
    "test:integration:native": "node scripts/native-runtime-integration.js",
    "test:bun": "node scripts/bun-runtime-integration.js bun-js && node scripts/bun-runtime-integration.js bun-ts",
    "test:corpus": "node scripts/corpus.js",
    "bench": "node scripts/benchmark.js",
    "check": "cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test && npm test",
    "pack:local": "node scripts/package.js local",
    "pack:release": "node scripts/package.js release",
    "prepack": "node scripts/check-package.js"
  },
  "napi": {
    "binaryName": "stryker-rust",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "dependencies": {
    "@babel/core": "~8.0.0",
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/instrumenter": "10.0.0",
    "@stryker-mutator/util": "10.0.0",
    "typed-inject": "5.0.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.8",
    "@stryker-mutator/mocha-runner": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "mocha": "^11.0.0",
    "svelte": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
