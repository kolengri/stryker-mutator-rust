{
  "testRunner": "command",
  "plugins": [],
  "appendPlugins": [],
  "checkers": [],
  "mutate": ["src/**/*.js"],
  "commandRunner": { "command": "bun --no-env-file test ./test/calculator.test.js" },
  "reporters": ["json"],
  "jsonReporter": { "fileName": "reports/mutation.json" },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 1000,
  "timeoutFactor": 2,
  "thresholds": { "high": 80, "low": 60, "break": 0 },
  "cleanTempDir": "always"
}
